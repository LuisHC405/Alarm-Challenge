{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "outDir": "public/client",
    "rootDir": "src/client",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "tsBuildInfoFile": "public/client/tsconfig.client.tsbuildinfo",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/client/**/*.ts"]
}
