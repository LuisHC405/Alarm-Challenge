{
  "name": "alarm-challenge",
  "version": "2.0.0",
  "description": "API e frontend de alarme que exige resolver uma conta de matematica para desligar",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && node -e \"const fs=require('fs');fs.mkdirSync('public/client',{recursive:true});fs.copyFileSync('src/client/index.html','public/client/index.html');fs.copyFileSync('src/client/styles.css','public/client/styles.css');\"",
    "start": "npm run build && node dist/server.js",
    "dev": "nodemon --watch server.ts --watch src --ext ts,html,css --exec \"npm run build && node dist/server.js\"",
    "test": "npm run build && node --test dist/server.test.js"
  },
  "keywords": [
    "alarm",
    "api",
    "math",
    "frontend"
  ],
  "author": "LuisHC405",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "nodemon": "^2.0.20",
    "typescript": "^5.5.3"
  }
}
